# Virtualization: enable KVM (ovaltine custom, 2026-10-11)
#
# Background:
#   CONFIG_KVM=y is on in gki_defconfig, but the vendor fragment
#   vendor/oplus/waipio_GKI.config turns it off in its "# Bloat" section
#   (around line 175 of that file, next to CONFIG_VSOCKETS and CONFIG_MMC).
#   This overrides it back on.
#
# Prerequisites:
#   CONFIG_VIRTUALIZATION=y is already provided in gki_defconfig.
#   ⚠️ On ARM64 KVM needs the kernel running at EL2; if the bootloader puts the kernel at EL1,
#      it won't start even if built in. Check /dev/kvm and dmesg after flashing.
#
# Rollback: delete this file and remove vendor/oplus/kvm.config from BoardConfigCommon.mk
CONFIG_KVM=y
