# Network congestion control: enable BBR (ovaltine custom, 2026-10-11)
#
# Why this was added:
#   gki_defconfig has only reno/cubic; measured on this device
#   /proc/sys/net/ipv4/tcp_available_congestion_control = "reno cubic",
#   while net/ipv4/tcp_bbr.c is in the source tree but just wasn't built.
#
#   [Pitfall 1] BBR is inside Kconfig's `if TCP_CONG_ADVANCED` block,
#         so CONFIG_TCP_CONG_ADVANCED must be enabled first, otherwise CONFIG_TCP_CONG_BBR=y alone
#         is silently dropped during olddefconfig (hit on the first attempt on 2026-10-11,
#         showing only "# CONFIG_TCP_CONG_ADVANCED is not set" in .config).
#   [Pitfall 2] The default algorithm isn't set here: CONFIG_DEFAULT_TCP_CONG is the result of a choice,
#         and writing the string directly is normalized back to cubic. After boot, the device tree's
#         configure_network_tuning() in init.kernel.post_boot-cape.sh
#         switches to bbr with sysctl, so rolling back only changes the script without a kernel rebuild.
#   The fq queue is already provided by gki_defconfig (CONFIG_NET_SCH_FQ=y), so it isn't declared again here.
#
# Manual runtime switch: sysctl net.ipv4.tcp_congestion_control=bbr
# Rollback: delete this file and remove vendor/oplus/lineage_net.config from BoardConfigCommon.mk
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
