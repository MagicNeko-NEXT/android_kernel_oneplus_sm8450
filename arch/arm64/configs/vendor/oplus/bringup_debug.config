# Keep pstore records readable after a crash.
# CONFIG_PSTORE_COMPRESS is not set
CONFIG_INPUT_QPNP_POWER_ON=m
# Show the kernel log on the panel through the bootloader's splash framebuffer.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# The vendor msm_drm has no fbdev code, so use simplefb instead of simpledrm.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y
# Reboot 5 seconds after a panic, and turn lockups into panics. That reset is
# warm, so the ramoops console survives for the other slot's recovery to read.
CONFIG_PANIC_TIMEOUT=5
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
# Paint per-stage colour bands and a RAM-dump record into the splash buffer.
CONFIG_OPLUS_BRINGUP_SPLASH_MARKERS=y
